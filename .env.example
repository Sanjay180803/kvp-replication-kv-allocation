# Copy to ~/ml-learning-to-evict/.env and edit the paths for your account.
KVCOMPRESSION_DATA_ROOT=/scratch2/YOUR_USER/kvp/data
KVCOMPRESSION_MODEL_ID=/scratch2/YOUR_USER/kvp/models/Qwen2.5-7B-Instruct
WANDB_MODE=disabled
# S3 is not used; leave the bucket unset. "storage failed" messages at the end of training are expected.
# KV_REMOTE_AGENTS_DIR=
